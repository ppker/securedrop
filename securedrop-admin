#!/bin/bash
# Minimal migration-only wrapper for securedrop-admin
# This script is used ONLY for the one-time migration from git-based to deb-based installer
# After migration, users will use /usr/bin/securedrop-admin from the installed package
set -eo pipefail

# Check that we're not running as root
b=$(basename "$0")
u=$(whoami)
if test "$u" = "root"; then
    echo "Please do not run \"$b\" directly as root."
    exit 1
fi

# Get the directory this script is in
d=$(dirname "$0")

# Only support setup and tailsconfig commands for migration
if [ "$1" = "setup" ]; then
    exec "$d/admin/migrate-to-deb.sh"
elif [ "$1" = "tailsconfig" ]; then
    exec "$d/admin/migrate-tailsconfig.sh"
else
    echo "Error: This git-based installer has been deprecated."
    echo ""
    echo "To migrate to the new package-based installer, run:"
    echo "  ./securedrop-admin setup"
    echo ""
    echo "After migration, use 'securedrop-admin' (installed in /usr/bin) for all operations."
    exit 1
fi
